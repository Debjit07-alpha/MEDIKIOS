# Port the API listens on (Render injects PORT automatically).
PORT=5000

# Supabase project URL.
SUPABASE_URL=

# Publishable (anon) key. Used only as a fallback; RLS blocks it from
# writing to patients, interview_sessions, interview_responses, consents,
# consultations and clinical_summaries.
SUPABASE_PUBLISHABLE_KEY=

# REQUIRED for persistence. Service-role (secret) key — backend ONLY.
# The kiosk backend writes to RLS-protected medical tables through this key.
# NEVER expose it to React/Vite (no VITE_ prefix, never commit backend/.env).
# Get it at: Supabase Dashboard → Project Settings → API → service_role key.
# Must also be set as an environment variable on Render.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API key — used ONLY by the backend for medical document
# analysis (POST /api/ocr/analyze, POST /api/ocr/retry-analysis).
# The frontend NEVER reads this key.
# Get a key at https://console.anthropic.com/
# Never commit the real key. Paste it into backend/.env locally and set it
# as an environment variable on your hosting provider.
ANTHROPIC_API_KEY=

# Optional: Claude model used by the medical document analysis.
# Defaults to claude-sonnet-4-5 when not set. Must be a model ID available
# to your Anthropic account.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Legacy Google Gemini API key — no longer in the OCR path (Claude is the
# configured provider). Kept only so the untouched geminiMedical module can
# still load if referenced elsewhere.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional legacy Gemini model (unused by the OCR flow).
# GEMINI_MODEL=gemini-2.5-flash