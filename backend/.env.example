# Anthropic Claude API key — used ONLY by the backend for medical document
# analysis (POST /api/ocr/analyze, POST /api/ocr/retry-analysis).
# The frontend NEVER reads this key.
# Get a key at https://console.anthropic.com/
# Never commit the real key. Paste it into backend/.env locally and set it
# as an environment variable on your hosting provider.
ANTHROPIC_API_KEY=

# Optional: Claude model used by the medical document analysis.
# Defaults to claude-sonnet-4-5 when not set. Must be a model ID available
# to your Anthropic account.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Legacy Google Gemini API key — no longer in the OCR path (Claude is the
# configured provider). Kept only so the untouched geminiMedical module can
# still load if referenced elsewhere.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional legacy Gemini model (unused by the OCR flow).
# GEMINI_MODEL=gemini-2.5-flash